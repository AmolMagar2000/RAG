JINA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Embeddings: jina-embeddings-v5-omni-small, 1024 dimensions
EMBEDDING_DIM=1024
# Leave QDRANT_URL empty to use embedded (on-disk) Qdrant at QDRANT_PATH. Set it for a server/cloud.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=ukvi_policy
RERANK_ENABLED=false
RAGAS_JUDGE=groq
